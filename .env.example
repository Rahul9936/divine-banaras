# Copy this file to ".env.local" and fill in the value below.
# .env.local is git-ignored, so it never gets committed.

# --- Inquiry form email delivery (Web3Forms) ---
# The contact form emails your enquiries via Web3Forms (no backend server needed,
# works on static/shared hosting). To get a key:
#   1. Go to https://web3forms.com
#   2. Enter the email address where you want to RECEIVE enquiries
#      (e.g. info@divinebanaras.com) and click "Create Access Key".
#   3. The key is emailed to you instantly — paste it below.
#
# NOTE: this must be prefixed with NEXT_PUBLIC_ because the static site calls
# Web3Forms directly from the browser. The key is safe to expose — it only lets
# people send mail TO your registered address, nothing else.
NEXT_PUBLIC_WEB3FORMS_KEY=
